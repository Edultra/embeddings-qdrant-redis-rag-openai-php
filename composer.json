{
    "name": "eduardo/embeddings-qdrant-rag-openai-php",
    "description": "Projeto PHP de embeddings com Qdrant e RAG usando OpenAI",
    "version": "0.0.1",
    "type": "project",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*",
        "smalot/pdfparser": "^2.0",
        "predis/predis": "^3.6"
    },
    "authors": [
        {
            "name": "Eduardo de Souza",
            "email": "edultra@email.com"
        }
    ],
    "license": "MIT",
    "scripts": {
        "start": "php src/index.php",
        "dev": "php -d xdebug.remote_enable=1 src/index.php",
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    }
}
