## OPENAI CONFIGURATION
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=350
OPENAI_MAX_RETRIES=1
# Opcional: caminho para cacert.pem quando o PHP não tiver uma CA configurada.
OPENAI_CA_BUNDLE=

#MODELS
NLP_MODEL='gpt-4o-mini'

#embeddings (using transformers.js locally)
OPENAI_EMBEDDING_MODEL='text-embedding-3-small'

# Qdrant configuration
# Use o nome do serviço do docker-compose (qdrant_db) quando o PHP rodar em container.
# Use http://127.0.0.1:6333 se estiver rodando o PHP diretamente no host.
QDRANT_URL=http://qdrant_db:6333
QDRANT_API_KEY=
# IMPORTANTE: se você já indexou documentos antes, use o MESMO nome de coleção.
# Um nome diferente faz a aplicação não encontrar os vetores já indexados.
QDRANT_COLLECTION=rag_documents

# Cache local opcional via Redis. Sem REDIS_HOST, o cache usa arquivos em cache/.
# Use o nome do serviço do docker-compose (redis_db) quando o PHP rodar em container.
# Use 127.0.0.1 se estiver rodando o PHP diretamente no host.
REDIS_HOST=redis_db
REDIS_PORT=6379
REDIS_PASSWORD=

# Tamanho e sobreposição dos chunks de documento, em caracteres
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Teto de segurança opcional, só use se quiser um limite MENOR que CHUNK_SIZE.
# Deixe vazio para que o tamanho real do chunk seja exatamente CHUNK_SIZE.
MAX_CHUNK_SIZE=

# Quantidade de trechos retornados na busca vetorial e score mínimo (0-1) para considerar um trecho relevante
# Scores de cosine com embeddings da OpenAI costumam ficar na faixa 0.2-0.4 para trechos relevantes
SIMILARITY_TOP_K=3
MIN_SIMILARITY_SCORE=0.15