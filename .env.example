## OPENAI CONFIGURATION
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=350
OPENAI_MAX_RETRIES=1
# Opcional: caminho para cacert.pem quando o PHP não tiver uma CA configurada.
OPENAI_CA_BUNDLE=

#MODELS
NLP_MODEL='gpt-4o-mini'

#embeddings (using transformers.js locally)
OPENAI_EMBEDDING_MODEL='text-embedding-3-small'

# Qdrant configuration
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents

# Cache local opcional via Redis. Sem REDIS_HOST, o cache usa arquivos em cache/.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Maximum size of each document chunk in characters
MAX_CHUNK_SIZE=500